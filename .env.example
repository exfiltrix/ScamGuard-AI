# API Keys — replace with your actual values
# Never commit real secrets!

# Google Gemini API keys (round-robin rotation, auto-fallback on 429)
# Get from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEYS=key1,key2,key3

# Telegram Bot Token
# Get from: https://t.me/BotFather (command /newbot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider (choose: gemini, openai, or fallback)
AI_PROVIDER=gemini

# Database
DATABASE_URL=sqlite:///./scamguard.db

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=False

# AI Settings
AI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1500

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Logging
LOG_LEVEL=INFO
